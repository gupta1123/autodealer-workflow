;; Kalika Purchase voucher source-document integration for TallyPrime.
;;
;; The source PDF remains in Kalika-managed document storage. These UDFs
;; persist the exact document path, display name, checksum, and document ID
;; with the Purchase voucher so the source can be opened from Tally.

[System : UDF]
KalikaSourceDocumentPath   : String : 30001
KalikaSourceDocumentName   : String : 30002
KalikaSourceDocumentSha256 : String : 30003
KalikaSourceDocumentId     : String : 30004
KalikaVehicleNumber        : String : 30005

[#Form : VCH Display]
Add : Button : Kalika Open Source PDF

[#Form : Voucher]
Add : Button : Kalika Open Source PDF

[Button : Kalika Open Source PDF]
Title    : "Open Source PDF"
Key      : Ctrl + Alt + D
Action   : BrowseURL Ex : $KalikaSourceDocumentPath
Inactive : $$IsEmpty:$KalikaSourceDocumentPath
